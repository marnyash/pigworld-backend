# Copy to backend/app/.env before running `docker compose up` from backend/.
APP_NAME="Pig World"
APP_ENV=production
# Generate with `php artisan key:generate --show` and paste the result here.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

DB_DATABASE=pigworld
DB_USERNAME=pigworld
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

CORS_ALLOWED_ORIGINS=http://localhost

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS endpoint; use a tunnel while testing locally.
MPESA_CALLBACK_URL=
